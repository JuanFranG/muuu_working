# ============================================================
#  MUUU APP · Variables de entorno
#  Copia este archivo como ".env" y rellena con tus valores.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# ── Base de datos MySQL (Railway, Aiven, etc.) ────────────────
DB_HOST=your-mysql-host.railway.app
DB_PORT=3306
DB_NAME=muuu_db
DB_USER=muuu_user
DB_PASSWORD=your-secure-password

# ── Variables internas de MySQL (solo para docker-compose local) ──
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=muuu_db
MYSQL_USER=muuu_user
MYSQL_PASSWORD=your-secure-password

# ── Puertos locales (docker-compose dev) ─────────────────────
NGINX_PORT=8080
MYSQL_HOST_PORT=3307
