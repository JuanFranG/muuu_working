# ============================================================
#  MUUU APP · .gitignore
# ============================================================

# ── Secretos y configuración local ──────────────────────────
.env
.env.local
.env.*.local

# ── Dependencias de Node ─────────────────────────────────────
node_modules/
npm-debug.log*

# ── Build del frontend ───────────────────────────────────────
App Mockup Muuu v2026-4/dist/
App Mockup Muuu v2026-4/.vite/

# ── Uploads (archivos subidos en desarrollo local) ───────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── macOS ────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Claude Code (sesiones de trabajo, no van al repo) ────────
.claude/

# ── Archivos de backup / zip ─────────────────────────────────
*.zip

# ── Logs ─────────────────────────────────────────────────────
*.log
