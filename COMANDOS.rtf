FLASHCARDS CREADAS\
\
SELECT \
    f.id_flashcard,\
    f.pregunta,\
    f.respuesta,\
    t.nombre AS tema,\
    d.nombre AS dificultad\
FROM FLASHCARDS f\
JOIN TEMA t      ON f.id_tema       = t.id_tema\
JOIN DIFICULTAD d ON f.id_dificultad = d.id_dificultad\
ORDER BY f.id_flashcard;\
\
\
VER RANKING;\
\
SELECT \
    u.nombre,\
    r.nombre   AS rol,\
    u.totalPuntos,\
    u.nivel,\
    u.rachaActual\
FROM USUARIO u\
JOIN ROL r ON u.id_rol = r.id_rol\
ORDER BY u.totalPuntos DESC;\
\
PROGRESO DE MATERIALES\
\
SELECT \
    u.nombre        AS estudiante,\
    m.titulo        AS material,\
    pm.completado,\
    pm.fechaVisto\
FROM PROGRESO_MATERIAL pm\
JOIN USUARIO  u ON pm.id_usuario  = u.id_usuario\
JOIN MATERIAL m ON pm.id_material = m.id_material;\
