USUARIOS\
\
SELECT \
    u.id_usuario,\
    u.nombre,\
    u.correo,\
    r.nombre             AS rol,\
    u.nivel,\
    u.totalPuntos,\
    u.rachaActual,\
    u.flashcardsEstudiadas,\
    u.esActivo,\
    u.fechaRegistro\
FROM USUARIO u\
JOIN ROL r ON u.id_rol = r.id_rol\
ORDER BY u.fechaRegistro DESC;\
\
\
CANTIDAD DE USUARIOS POR ROL\
\
SELECT \
    r.nombre AS rol,\
    COUNT(*) AS total\
FROM USUARIO u\
JOIN ROL r ON u.id_rol = r.id_rol\
GROUP BY r.nombre;\
\
USUARIO POR CORREO\
\
SELECT id_usuario, nombre, correo, esActivo\
FROM USUARIO\
WHERE correo = 'ada@muuu.com';\
\
